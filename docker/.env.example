# =============================================================================
# Per-school config. Copy to `docker/.env` aur values bharo. `.env` git mein NAHI jaata.
# =============================================================================

# SQLite DB path CONTAINER ke andar — /data volume par (change karne ki zaroorat nahi).
DB_PATH=/data/paper_maker.db

# API key — teachers ise ek dafa app ke "Access key" box mein daalenge.
# Lambi random string rakho (har school ke liye alag). Khaali chhodne par LAN par
# auth OFF ho jayega (sirf tab jab network fully trusted ho).
PAPER_MAKER_API_KEY=change-me-to-a-long-random-key

# Gemini API key — AI question generation ke liye (internet ke saath). Na ho to
# baaki app chalti hai, sirf AI-generate band.
GEMINI_API_KEY=your-gemini-api-key

# Host port (school apna port badal sakta hai; container hamesha 8000 par sunta).
HOST_PORT=8000

# Optional: agar API ko kisi doosri origin/domain se call karna ho.
# PAPER_MAKER_ALLOWED_ORIGINS=http://192.168.1.25:8000
